# LLM BYOK baseline fallback configuration (assign the three processors in the Settings page instead)
# No default provider, base URL, or model is shipped, to avoid accidentally using public models when unconfigured.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=128000

# Embedding model has its own config (used by RAG); when empty it falls back to the LLM_* above
# LLM_EMBEDDINGS_BASE=
# LLM_EMBEDDINGS_KEY=
# LLM_EMBEDDINGS_MODEL=

# RAG backend: local | stepfun | none
RAG_BACKEND=local
# STEPFUN_VECTOR_STORE_ID=

# GitHub: optional fallback token when no credential is linked in Settings →
# Integrations → GitHub. Prefer a fine-grained PAT (public-repo read-only);
# authenticated quota is 5,000 req/hour vs 60 req/hour anonymous.
# GITHUB_TOKEN=

# Services
# Runtime data lives under src/realmock/platform/ (data/, uploads/, .env). Use absolute paths
# or paths relative to the platform directory, so the DB does not land in the wrong place
# when starting from the repository root.
# Two SQLite databases (recommended; legacy DATABASE_URL maps to the sessions database)
# API_DATABASE_URL=sqlite:///<absolute path to src/realmock/platform/data/api.db>
# SESSIONS_DATABASE_URL=sqlite:///<absolute path to src/realmock/platform/data/sessions.db>
# DATABASE_URL=sqlite:///<absolute path to src/realmock/platform/data/sessions.db>
# UPLOAD_DIR=<absolute path to src/realmock/platform/uploads>
# Port planning (configured through .env; code defaults are only a local fallback):
#   Default aggregated form: frontend + backend single aggregated process (local 8080 / 8081);
#   Standalone form: uvicorn realmock.asgi:app --port 8081
#   Changing ports only requires PORT / CORS_ORIGINS here; no code change needed.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8081
# ENV=dev
# ALLOW_LOCAL_LLM=false
# COOKIE_SECURE=   # true/false; leave empty for auto (https or trusted proxy X-Forwarded-Proto)
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Voice pipeline defaults (assign the three processors in the Settings page for real use; the thinking key must not be used as the ASR key)
# WHISPER_MODEL: used only when the transcription processor is local or on cloud-failure fallback (tiny/base/small/...)
WHISPER_MODEL=base
# TTS_VOICE: an Edge voice id, or another TTS provider's voice_id
TTS_VOICE=zh-CN-XiaoxiaoNeural
# SILENCE_NUDGE_SECONDS=25

# Setting a master key is strongly recommended in production (any >=16-byte string, or base64)
# When unset, the key defaults to src/realmock/platform/data/.secret.key (next to the databases)
# Note: when running as multiple standalone processes, SECRET_KEY must be set explicitly, otherwise
# each process generates its own key and API key ciphertext cannot be decrypted across processes.
# SECRET_KEY=
