# InterviewOS frontend environment example (required in production).
# Copy to .env.local and fill in real values; never commit secrets.

# Default consolidated ports: frontend 8080, backend 8081.
# With separate backend services: 8081 (api), 8082 (agent), 8083 (interview).

# Backend REST API base URL (direct connection; no Next.js proxy).
NEXT_PUBLIC_API_BASE=http://localhost:8081

# Direct WebSocket URL (bypasses Next.js proxy upgrade compatibility issues).
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# Direct SSE URL; must share an origin with NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_STREAM_API_BASE=http://localhost:8081
