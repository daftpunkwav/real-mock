{
  "name": "realmock-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev --port 8080",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --coverage.enabled",
    "test:watch": "vitest",
    "audit": "npm audit --json | node scripts/npm-audit-check.mjs",
    "export:openapi": "python ../../scripts/export_openapi.py",
    "generate:api-types": "npm run export:openapi && openapi-typescript ../../openapi.json -o src/types/generated/api.d.ts"
  },
  "dependencies": {
    "@met4citizen/talkinghead": "^1.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.5",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "next": "^16.3.6",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.4",
    "js-yaml": "4.3.2",
    "@redocly/openapi-core": "1.34.20",
    "undici": "^8.11.2"
  }
}
