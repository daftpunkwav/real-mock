#!/usr/bin/env bash
# Fast staged-only checks that mirror the CI gates (ruff, prettier). The full
# matrix - mypy, tests, audits, contract - stays in CI; this hook just keeps
# formatting and lint from leaving the machine. Zero dependencies: uses the
# project venv interpreters and whatever node/npm is on PATH.
#
# Checks run against the STAGED contents (git index), never the working tree:
# an unstaged "fix" in the worktree must not make an unformatted commit pass.
# Content is piped via stdin with --stdin-filename/--stdin-filepath so both
# tools resolve their per-file configuration against the real path without
# materializing temp copies.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
VENV_PY="$ROOT/.venv/Scripts/python.exe"
[ -x "$VENV_PY" ] || VENV_PY="$ROOT/.venv/bin/python"
cd "$ROOT"

py=()
while IFS= read -r f; do [ -n "$f" ] && py+=("$f"); done < <(
  git diff --cached --name-only --diff-filter=ACMR -- 'apps/api/*.py' 'scripts/*.py'
)
web=()
while IFS= read -r f; do [ -n "$f" ] && web+=("${f#apps/web/}"); done < <(
  git diff --cached --name-only --diff-filter=ACMR -- \
    'apps/web/*.ts' 'apps/web/*.tsx' 'apps/web/*.json' 'apps/web/*.css' 'apps/web/*.md'
)

if [ "${#py[@]}" -gt 0 ]; then
  for f in "${py[@]}"; do
    git show ":$f" | "$VENV_PY" -m ruff check --stdin-filename "$f" - >/dev/null
    git show ":$f" | "$VENV_PY" -m ruff format --check --stdin-filename "$f" - >/dev/null
  done
fi

if [ "${#web[@]}" -gt 0 ]; then
  (cd apps/web && for f in "${web[@]}"; do
    git show ":apps/web/$f" | npx prettier --stdin-filepath "$f" --check
  done)
fi

exit 0
