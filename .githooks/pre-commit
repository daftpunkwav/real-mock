#!/usr/bin/env bash
# Fast staged-only checks that mirror the CI gates (ruff, prettier). The full
# matrix - mypy, tests, audits, contract - stays in CI; this hook just keeps
# formatting and lint from leaving the machine. Zero dependencies: uses the
# project venv interpreters and whatever node/npm is on PATH.
#
# Checks run against the STAGED contents (git index), never the working tree:
# an unstaged "fix" in the worktree must not make an unformatted commit pass.
# Staged content is materialized into temp copies inside the repo (extension
# preserved) so ruff/prettier still discover their configuration.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
VENV_PY="$ROOT/.venv/Scripts/python.exe"
[ -x "$VENV_PY" ] || VENV_PY="$ROOT/.venv/bin/python"
cd "$ROOT"

TMP="$(mktemp -d "$ROOT/.git/hooks-staged-XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

# Materialize staged content for the paths read on stdin; prints one temp path
# per input path (flat names - extension preserved, collisions harmless).
stage_copies() {
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    t="$TMP/$(printf '%s' "$f" | tr '/' '_')"
    git show ":$f" > "$t"
    echo "$t"
  done
}

py_tmp=()
while IFS= read -r t; do py_tmp+=("$t"); done < <(
  git diff --cached --name-only --diff-filter=ACMR -- 'apps/api/*.py' 'scripts/*.py' | stage_copies
)
web_tmp=()
while IFS= read -r t; do web_tmp+=("$t"); done < <(
  git diff --cached --name-only --diff-filter=ACMR -- \
    'apps/web/*.ts' 'apps/web/*.tsx' 'apps/web/*.json' 'apps/web/*.css' 'apps/web/*.md' | stage_copies
)

if [ "${#py_tmp[@]}" -gt 0 ]; then
  "$VENV_PY" -m ruff check "${py_tmp[@]}"
  "$VENV_PY" -m ruff format --check "${py_tmp[@]}"
fi

if [ "${#web_tmp[@]}" -gt 0 ]; then
  npx prettier --check "${web_tmp[@]}"
fi

exit 0
