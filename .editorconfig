# Editor/formatter alignment: LF, UTF-8, final newline everywhere.
# Worktree may hold CRLF (core.autocrlf=true); saving as LF still commits
# to the same normalized LF blobs, so this must not cause dirty diffs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc,yml,yaml,css,scss,html}]
indent_size = 2

# Trailing double-spaces are hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
